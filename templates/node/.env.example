# 複製為 .env 供本機開發;上線一律用 scaffold 產生的 deploy/.env.production。
# 兩檔皆已列入 .gitignore,絕不進 git。

# --- app ---
# 本機 development;上線由 deploy/.env.production 設為 production
NODE_ENV=development
APP_URL=http://localhost:3000

# --- app 的資料庫連線(host 固定為 compose service 名 postgres) ---
# 使用者 / 密碼 / 資料庫名必須與下方 POSTGRES_* 完全對應
DATABASE_URL=postgres://{{SITE}}:change-me@postgres:5432/{{SITE}}

# --- postgres 容器初始化(首次啟動時建立使用者與資料庫) ---
POSTGRES_USER={{SITE}}
POSTGRES_PASSWORD=change-me
POSTGRES_DB={{SITE}}
