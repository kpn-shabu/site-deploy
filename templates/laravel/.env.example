# {{SITE}} — Laravel 環境變數範本
# scaffold 由此產出兩份(皆在 .gitignore,不進 git):
#   .env                   → 本機開發用
#   deploy/.env.production → 上線唯一來源(APP_ENV=production、APP_DEBUG=false、
#                            APP_URL=https://{{DOMAIN}}、隨機 DB 密碼)

APP_NAME={{SITE}}
APP_ENV=local
# 執行 php artisan key:generate 產生
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# ── 資料庫(Laravel 端)────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE={{SITE}}
DB_USERNAME={{SITE}}
DB_PASSWORD=

# ── 資料庫(postgres 容器初始化用;必須與上方 DB_* 一致)──
POSTGRES_DB={{SITE}}
POSTGRES_USER={{SITE}}
POSTGRES_PASSWORD=

# ── driver 預設值(啟用 queue worker 時將 QUEUE_CONNECTION 改為 database 等)──
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
