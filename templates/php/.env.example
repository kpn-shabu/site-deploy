# .env 範本:複製為 .env(本機開發用)後填值;.env 不進 git。
# 上線用的 deploy/.env.production 由 scaffold 另行產製(APP_ENV=production、隨機 DB 密碼)。

# ── 應用程式 ──────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# ── 資料庫(app 端連線;DB_HOST 固定用 compose service 名)──
DB_HOST=postgres
DB_DATABASE={{SITE}}
DB_USERNAME={{SITE}}
DB_PASSWORD=change-me

# ── PostgreSQL 容器初始化(必須與上方 DB_* 同值對應)────────
POSTGRES_DB={{SITE}}
POSTGRES_USER={{SITE}}
POSTGRES_PASSWORD=change-me

# ── CodeIgniter 4 專用(純手寫 PHP 免填;CI4 專案取消註解並對應填值)──
# CI_ENVIRONMENT=development
# app.baseURL=http://localhost:8080/
# database.default.hostname=postgres
# database.default.database={{SITE}}
# database.default.username={{SITE}}
# database.default.password=change-me
# database.default.DBDriver=Postgre
# database.default.port=5432
